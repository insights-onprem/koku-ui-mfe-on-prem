{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "paths": {
      "@koku/i18n": ["../i18n/src/i18n"],
      "@koku/i18n/messages": ["../i18n/src/messages.ts"],
      "api/*": ["../api/src/api/*"],
      "routes/components/*": ["./src/components/*"],
      "routes/utils/*": ["./src/utils/*"],
      "utils/*": ["./src/utils/*"],
      "store/*": ["./src/__app__/store/*"],
      "routes": ["./src/__app__/routes"]
    }
  },
  "include": ["./src/**/*.ts*"],
  "exclude": ["**/*.test.ts*"]
}

